APP_ENV=development
PORT=8000
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.55
ALLOWED_ORIGINS=
REINDEX_ENABLED=true

# O modo local não precisa de provider nem de credencial.
EXTERNAL_PROCESSING_ENABLED=false
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
